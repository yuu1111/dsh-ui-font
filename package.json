{
	"name": "dsh-ui-font",
	"version": "1.1.1",
	"description": "DeepSeek Harness Web GUI plugin: set the UI and code font families from Settings → General (--dsw-font-family, --dsw-font-mono, --ds-font-family-code)",
	"keywords": [
		"cordis",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"font",
		"font-family",
		"plugin",
		"typeface",
		"web-ui"
	],
	"homepage": "https://github.com/yuu1111/dsh-ui-font#readme",
	"bugs": {
		"url": "https://github.com/yuu1111/dsh-ui-font/issues"
	},
	"license": "MIT",
	"author": {
		"name": "yuu1111"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/dsh-ui-font.git"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"README.ja.md",
		"LICENSE"
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun build.ts",
		"prepack": "bun run build",
		"check": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"check:quality": "quality-check",
		"test": "bun run build && bun test"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-locale"
			]
		}
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
		"@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2",
		"@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.2"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-locale": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-renderer": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-settings": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@deepseek-ai/cordis": "^4.0.2",
		"@deepseek-ai/dsh-client-store": "^0.1.5-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.2",
		"@deepseek-ai/schemastery": "^3.18.2",
		"@types/bun": "^1.4.2",
		"@types/react": "~19.3.0",
		"@yuu1111/biome-config": "^2.0.1",
		"@yuu1111/code-style-check": "^0.1.1",
		"@yuu1111/comment-check": "^2.2.2",
		"@yuu1111/document-style-check": "^0.3.4",
		"@yuu1111/knip-config": "^1.0.7",
		"@yuu1111/quality-check": "^0.9.0",
		"@yuu1111/tsconfig": "^1.0.7",
		"@yuu1111/tsdoc-check": "^2.0.3",
		"knip": "^6.35.1",
		"react": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
