{
	"name": "dsh-ui-font",
	"version": "1.2.1",
	"description": "DeepSeek Harness Web GUI plugin: set the UI and code font families from Settings → General (--dsw-font-family, --dsw-font-mono, --ds-font-family-code)",
	"keywords": [
		"cordis",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"font",
		"font-family",
		"plugin",
		"typeface",
		"web-ui"
	],
	"homepage": "https://github.com/yuu1111/dsh-ui-font#readme",
	"bugs": {
		"url": "https://github.com/yuu1111/dsh-ui-font/issues"
	},
	"license": "MIT",
	"author": {
		"name": "yuu1111"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/dsh-ui-font.git"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"README.ja.md",
		"LICENSE"
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.34.6",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"scripts": {
		"build": "tsx build.ts",
		"prepack": "pnpm run build",
		"check": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"check:quality": "quality-check",
		"test": "pnpm run build && vitest run"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-locale"
			]
		}
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-locale": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-renderer": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-settings": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@deepseek-ai/cordis": "^4.0.4",
		"@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
		"@deepseek-ai/schemastery": "^3.18.4",
		"@types/node": "^24.0.0",
		"@types/react": "~19.3.0",
		"@yuu1111/biome-config": "^2.2.2",
		"@yuu1111/knip-config": "^2.1.0",
		"@yuu1111/quality-check": "^5.3.1",
		"@yuu1111/tsconfig": "^1.0.8",
		"esbuild": "^0.28.2",
		"knip": "^6.41.0",
		"react": "^19.3.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
