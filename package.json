{
	"name": "dsh-ui-font",
	"version": "0.1.0",
	"description": "DeepSeek Harness Web GUI plugin: override the UI font family (--dsw-font-family, --dsw-font-mono, --ds-font-family-code)",
	"keywords": [
		"cordis",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"font",
		"font-family",
		"plugin",
		"typeface",
		"web-ui"
	],
	"homepage": "https://github.com/yuu1111/dsh-ui-font#readme",
	"bugs": {
		"url": "https://github.com/yuu1111/dsh-ui-font/issues"
	},
	"license": "MIT",
	"author": {
		"name": "yuu1111"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/dsh-ui-font.git"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"README.ja.md",
		"LICENSE"
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun build.ts",
		"prepack": "bun run build",
		"check": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"test": "bun run build && bun test"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-theme"
			]
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "^1.4.2",
		"@yuu1111/biome-config": "^1.3.5",
		"@yuu1111/tsconfig": "^1.0.4",
		"typescript": "^7.0.2"
	}
}
